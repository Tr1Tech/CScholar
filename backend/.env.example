# Copy this file to ".env" and edit DATABASE_URL before starting the backend:
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# The real .env is gitignored - never commit it.

# App
SECRET_KEY=change-me-in-production
DEBUG=1

# Database - REQUIRED. Replace the password with the one you set when
# installing PostgreSQL. Leaving this placeholder makes /api/db-test hang
# for ~30 seconds and log "password authentication failed for user \"user\"".
# Percent-encode special characters in the password (@ -> %40, : -> %3A).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cscholar

# When the repo root has a `.env.local` written by `neon deploy`, the backend
# loads it first and these Neon values win over the local ones above. Point the
# app at Neon's DIRECT endpoint (no "-pooler") because the app pins
# search_path per connection; transaction-mode pooling drops session state.
# DATABASE_URL_UNPOOLED=postgresql://...@ep-....aws.neon.tech/neondb?sslmode=require

# AI/ML - embedding model. Changing EMBEDDING_MODEL requires re-embedding and a
# matching vector(...) dimension in db/schema.sql.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Which embedding runtime to load: auto | fastembed | sentence-transformers.
#   auto (default)  -> fastembed when installed, otherwise sentence-transformers
#   fastembed       -> ONNX runtime, ~170 MB RSS (required on a 512 MB host)
#   sentence-transformers -> torch, ~520 MB RSS (local development)
# Both run the same MiniLM weights.
EMBEDDING_BACKEND=auto
# Where fastembed caches the ONNX model (default: backend/.fastembed_cache).
# Point this at a project-local folder so a build step can warm it.
# FASTEMBED_CACHE_DIR=

# Object storage for thesis PDFs (optional). Leave unset to use app/uploads.
# On a host without a persistent disk, set these to keep PDFs across restarts.
# Neon Object Storage provides AWS_*-style credentials:
# AWS_ENDPOINT_URL_S3=https://<branch-endpoint>.storage.<region>.aws.neon.tech
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=cscholar-pdfs

# Optional: comma-separated origins allowed to call the API from a browser.
# Leave empty to allow any origin (fine for local development).
# CORS_ORIGINS=http://localhost:8080,https://tr1tech.github.io
